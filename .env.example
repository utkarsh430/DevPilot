# ─────────────────────────────────────────────────────────────────────────────
# You usually DON'T need to edit this file by hand anymore:
#   • Local dev from a fresh clone → `pnpm setup:local` copies this file to
#     apps/web/.env.local and fills every value a local stack needs (local
#     Supabase keys, a local Redis, generated secrets, your runner tenant).
#     Re-running it never overwrites a value that is already set - blank a
#     line and re-run to change it.
#   • Otherwise → open the app; every route redirects to /setup, which
#     writes the boot values below for you (unlock token prints in the server
#     console). Settings → Setup then walks each credential with live
#     validation, writing env-managed keys here and the rest into the
#     encrypted platform-secrets store.
# This file remains the documentation of every supported variable.
#
# RENAME NOTE (transitional): the platform's env vars were `ACE_*` and are now
# `DEVPILOT_*`. An existing `.env.local` does NOT need editing — a legacy alias
# shim mirrors any `ACE_<X>` you already have onto `DEVPILOT_<X>` at boot (an
# explicitly-set new name always wins). Prefer the new names for anything you
# add; the shim is removed once the rename completes.
# ─────────────────────────────────────────────────────────────────────────────

# ---- Anthropic / Runners ----
# Local Claude Code Runner (default): authenticate the runner host with your Pro/Max subscription.
# Create once on the always-on host with `claude setup-token` and store securely (NOT in this repo).
# Optional in local dev — the worker falls back to whatever `claude` is already authenticated as.
CLAUDE_CODE_OAUTH_TOKEN=

# API Runner (optional): per-token usage.
ANTHROPIC_API_KEY=

# Which of these two credentials the platform uses is an explicit per-tenant
# setting (Settings → LLM auth, stored in `tenants.config.llm_auth_mode`), NOT
# inferred from which var is set: `claude_code` (default) routes to the local
# runner above; `api_key` routes to the ANTHROPIC_API_KEY path. A fresh install
# defaults to Claude Code auth with no API key required.

# ---- LLM provider (WI-12) ----
# Which ENDPOINT a project's agents talk to, as opposed to which CREDENTIAL
# (above). Default `anthropic` everywhere; a project (or a tenant, via
# `tenants.config.llm_provider`) can select `openai_compatible` to point at any
# server speaking the OpenAI /chat/completions API — Ollama, vLLM, LiteLLM, a
# gateway, or OpenAI itself. That provider is API-PATH ONLY: the local-cc runner
# is the Claude CLI and can't speak it, so those runs are routed to the API
# runner automatically. Per-project settings (project page → LLM provider) take
# precedence over these instance-level defaults.
#
# Both are also settable from Settings → Setup (platform-secrets instance scope),
# which is the preferred place — no restart needed.
LLM_PROVIDER_BASE_URL=
LLM_PROVIDER_API_KEY=

# SSRF controls for the base URL above. It is user-controllable and drives
# server-side fetches, so it is validated at BOTH write and call time: https
# only, no credentials-in-URL, and the host is RESOLVED with every returned
# address required to be public (private/loopback/link-local/CGNAT/metadata
# ranges are refused — 169.254.169.254 is the reason this exists).
#
# DEVPILOT_LLM_ALLOW_LOCAL_BASE_URL: DEV ONLY. Permits an http:// localhost endpoint
# (Ollama's default is http://localhost:11434). OFF unless set — a production
# instance must never treat "points at me" as a valid LLM endpoint.
DEVPILOT_LLM_ALLOW_LOCAL_BASE_URL=
# DEVPILOT_LLM_BASE_URL_ALLOWLIST: optional hostname pin, comma-separated. A leading
# dot matches subdomains (`.corp.example.com`). Unset = any host that passes the
# address checks. Set it if you want a hard allowlist of endpoints.
DEVPILOT_LLM_BASE_URL_ALLOWLIST=

# ---- Platform secrets (manage config from the UI) ----
# DEFAULT ON. The app resolves config at runtime as tenant override » instance »
# env, so operators set keys (ANTHROPIC_API_KEY, LANGFUSE_*, GITHUB_OAUTH_*, …)
# from Settings → Setup / Platform secrets instead of editing this file. An
# empty store falls back to env for every key, so env-only installs behave
# identically. Set explicitly to 0 to force env-only resolution (store writes
# then fail loudly instead of no-opping). Values are AES-256-GCM at rest —
# requires SECRETS_ENCRYPTION_KEY (see bottom of this file) for any write.
DEVPILOT_PLATFORM_SECRETS_ENABLED=
# Optional: how long (seconds) the resolver caches a tenant's secrets. Default 60.
DEVPILOT_PLATFORM_SECRETS_TTL_SECONDS=60

# ---- Local Claude Code Runner config ----
# Internal shared secret used by the worker → engine handshake. Generate any random string
# (e.g. `openssl rand -base64 32`). NOT a user credential.
DEVPILOT_RUNNER_REGISTRATION_KEY=
# REQUIRED. Binds this local runner to a tenant so the engine can register it
# and scope its jobs/config. `pnpm setup:local` fills it from the account you
# name (it creates that account in the local Supabase so the tenant exists
# before anyone has signed in). Otherwise it is a uuid from `public.tenants`
# (`select id from public.tenants` in Studio; the /welcome page also prints
# yours). Missing this fails boot with `missing required env var:
# DEVPILOT_RUNNER_TENANT_ID`.
DEVPILOT_RUNNER_TENANT_ID=
# Optional. The name this runner registers under (the `runners` row is upserted
# on tenant + name). Unset = `local-cc-<platform>-<pid>`, i.e. a NEW row per
# start and a trail of offline ones; `pnpm setup:local` sets a stable
# `local-cc-<hostname>` so every start re-registers the same row.
DEVPILOT_RUNNER_NAME=
# Subscription-safe concurrency cap on the local worker (~1–3 is typical).
LOCAL_CC_CONCURRENCY=2
# URL the worker uses to reach the engine. For local dev, the Next.js dev
# server. 127.0.0.1 rather than localhost: it matches NEXT_PUBLIC_APP_URL and
# keeps name resolution out of the runner's hot path.
LOCAL_CC_ENGINE_URL=http://127.0.0.1:3000

# ---- "Take the wheel" — interactive Claude takeover (local runner only) ----
# When an operator clicks "Take the wheel" on a running local-cc run, the runner
# opens an INTERACTIVE `claude --continue --dangerously-skip-permissions` session
# in a tmux pane (surfaced in a macOS terminal) so a human can drive the ticket
# by hand; the session's transcript is mirrored back into the ticket log. Skip-
# permissions is acceptable here because a human is attached and watching — their
# presence is the approval gate (the untrusted-content rule). Requires `tmux` on the runner
# host (`brew install tmux`); a no-op with a friendly hint when tmux is absent.
# Default on, but inert until a human clicks the button. Never reached on the
# API/multi-tenant runner path. Set to false to disable entirely on this host.
LOCAL_CC_TAKEOVER_ENABLED=true
# How long (ms) the interactive pane lingers, still attachable, after control is
# released before the runner kills it ("not immediately"). Default 60s.
LOCAL_CC_TMUX_CLOSE_DELAY_MS=60000
# macOS terminal used to surface the session: "Terminal" (default) or "iTerm".
# Any other value leaves the detached tmux session for manual `tmux attach`.
LOCAL_CC_TERMINAL_APP=Terminal

# ---- Cost-velocity circuit breaker (Phase 1 fast-follow after Wave 3 runaway) ----
# Per-tenant ceiling for aggregate spend per 60s window, in cents. When the
# bucket goes over, no new LLM step starts for the tenant until the window
# rolls. a P0 design rule. Default $5/min/tenant.
# Set to 0 to disable (NOT recommended outside isolated test environments).
DEVPILOT_TENANT_VELOCITY_CENTS_PER_MIN=500

