# ─────────────────────────────────────────────────────────────────────────────
# You usually DON'T need to edit this file by hand anymore:
#   • Local dev from a fresh clone → `pnpm setup:local` copies this file to
#     apps/web/.env.local and fills every value a local stack needs (local
#     Supabase keys, a local Redis, generated secrets, your runner tenant).
#     Re-running it never overwrites a value that is already set - blank a
#     line and re-run to change it.
#   • Otherwise → open the app; every route redirects to /setup, which
#     writes the boot values below for you (unlock token prints in the server
#     console). Settings → Setup then walks each credential with live
#     validation, writing env-managed keys here and the rest into the
#     encrypted platform-secrets store.
# This file remains the documentation of every supported variable.
#
# RENAME NOTE (transitional): the platform's env vars were `ACE_*` and are now
# `DEVPILOT_*`. An existing `.env.local` does NOT need editing — a legacy alias
# shim mirrors any `ACE_<X>` you already have onto `DEVPILOT_<X>` at boot (an
# explicitly-set new name always wins). Prefer the new names for anything you
# add; the shim is removed once the rename completes.
# ─────────────────────────────────────────────────────────────────────────────

# ---- Anthropic / Runners ----
# Local Claude Code Runner (default): authenticate the runner host with your Pro/Max subscription.
# Create once on the always-on host with `claude setup-token` and store securely (NOT in this repo).
# Optional in local dev — the worker falls back to whatever `claude` is already authenticated as.
CLAUDE_CODE_OAUTH_TOKEN=

# API Runner (optional): per-token usage.
ANTHROPIC_API_KEY=

# Which of these two credentials the platform uses is an explicit per-tenant
# setting (Settings → LLM auth, stored in `tenants.config.llm_auth_mode`), NOT
# inferred from which var is set: `claude_code` (default) routes to the local
# runner above; `api_key` routes to the ANTHROPIC_API_KEY path. A fresh install
# defaults to Claude Code auth with no API key required.

# ---- LLM provider (WI-12) ----
# Which ENDPOINT a project's agents talk to, as opposed to which CREDENTIAL
# (above). Default `anthropic` everywhere; a project (or a tenant, via
# `tenants.config.llm_provider`) can select `openai_compatible` to point at any
# server speaking the OpenAI /chat/completions API — Ollama, vLLM, LiteLLM, a
# gateway, or OpenAI itself. That provider is API-PATH ONLY: the local-cc runner
# is the Claude CLI and can't speak it, so those runs are routed to the API
# runner automatically. Per-project settings (project page → LLM provider) take
# precedence over these instance-level defaults.
#
# Both are also settable from Settings → Setup (platform-secrets instance scope),
# which is the preferred place — no restart needed.
LLM_PROVIDER_BASE_URL=
LLM_PROVIDER_API_KEY=

# SSRF controls for the base URL above. It is user-controllable and drives
# server-side fetches, so it is validated at BOTH write and call time: https
# only, no credentials-in-URL, and the host is RESOLVED with every returned
# address required to be public (private/loopback/link-local/CGNAT/metadata
# ranges are refused — 169.254.169.254 is the reason this exists).
#
# DEVPILOT_LLM_ALLOW_LOCAL_BASE_URL: DEV ONLY. Permits an http:// localhost endpoint
# (Ollama's default is http://localhost:11434). OFF unless set — a production
# instance must never treat "points at me" as a valid LLM endpoint.
DEVPILOT_LLM_ALLOW_LOCAL_BASE_URL=
# DEVPILOT_LLM_BASE_URL_ALLOWLIST: optional hostname pin, comma-separated. A leading
# dot matches subdomains (`.corp.example.com`). Unset = any host that passes the
# address checks. Set it if you want a hard allowlist of endpoints.
DEVPILOT_LLM_BASE_URL_ALLOWLIST=

# ---- Platform secrets (manage config from the UI) ----
# DEFAULT ON. The app resolves config at runtime as tenant override » instance »
# env, so operators set keys (ANTHROPIC_API_KEY, LANGFUSE_*, GITHUB_OAUTH_*, …)
# from Settings → Setup / Platform secrets instead of editing this file. An
# empty store falls back to env for every key, so env-only installs behave
# identically. Set explicitly to 0 to force env-only resolution (store writes
# then fail loudly instead of no-opping). Values are AES-256-GCM at rest —
# requires SECRETS_ENCRYPTION_KEY (see bottom of this file) for any write.
DEVPILOT_PLATFORM_SECRETS_ENABLED=
# Optional: how long (seconds) the resolver caches a tenant's secrets. Default 60.
DEVPILOT_PLATFORM_SECRETS_TTL_SECONDS=60

# ---- Local Claude Code Runner config ----
# Internal shared secret used by the worker → engine handshake. Generate any random string
# (e.g. `openssl rand -base64 32`). NOT a user credential.
DEVPILOT_RUNNER_REGISTRATION_KEY=
# REQUIRED. Binds this local runner to a tenant so the engine can register it
# and scope its jobs/config. `pnpm setup:local` fills it from the account you
# name (it creates that account in the local Supabase so the tenant exists
# before anyone has signed in). Otherwise it is a uuid from `public.tenants`
# (`select id from public.tenants` in Studio; the /welcome page also prints
# yours). Missing this fails boot with `missing required env var:
# DEVPILOT_RUNNER_TENANT_ID`.
DEVPILOT_RUNNER_TENANT_ID=
# Optional. The name this runner registers under (the `runners` row is upserted
# on tenant + name). Unset = `local-cc-<platform>-<pid>`, i.e. a NEW row per
# start and a trail of offline ones; `pnpm setup:local` sets a stable
# `local-cc-<hostname>` so every start re-registers the same row.
DEVPILOT_RUNNER_NAME=
# Subscription-safe concurrency cap on the local worker (~1–3 is typical).
LOCAL_CC_CONCURRENCY=2
# URL the worker uses to reach the engine. For local dev, the Next.js dev
# server. 127.0.0.1 rather than localhost: it matches NEXT_PUBLIC_APP_URL and
# keeps name resolution out of the runner's hot path.
LOCAL_CC_ENGINE_URL=http://127.0.0.1:3000

# ---- "Take the wheel" — interactive Claude takeover (local runner only) ----
# When an operator clicks "Take the wheel" on a running local-cc run, the runner
# opens an INTERACTIVE `claude --continue --dangerously-skip-permissions` session
# in a tmux pane (surfaced in a macOS terminal) so a human can drive the ticket
# by hand; the session's transcript is mirrored back into the ticket log. Skip-
# permissions is acceptable here because a human is attached and watching — their
# presence is the approval gate (the untrusted-content rule). Requires `tmux` on the runner
# host (`brew install tmux`); a no-op with a friendly hint when tmux is absent.
# Default on, but inert until a human clicks the button. Never reached on the
# API/multi-tenant runner path. Set to false to disable entirely on this host.
LOCAL_CC_TAKEOVER_ENABLED=true
# How long (ms) the interactive pane lingers, still attachable, after control is
# released before the runner kills it ("not immediately"). Default 60s.
LOCAL_CC_TMUX_CLOSE_DELAY_MS=60000
# macOS terminal used to surface the session: "Terminal" (default) or "iTerm".
# Any other value leaves the detached tmux session for manual `tmux attach`.
LOCAL_CC_TERMINAL_APP=Terminal

# ---- Cost-velocity circuit breaker (Phase 1 fast-follow after Wave 3 runaway) ----
# Per-tenant ceiling for aggregate spend per 60s window, in cents. When the
# bucket goes over, no new LLM step starts for the tenant until the window
# rolls. a P0 design rule. Default $5/min/tenant.
# Set to 0 to disable (NOT recommended outside isolated test environments).
DEVPILOT_TENANT_VELOCITY_CENTS_PER_MIN=500

# ---- QA retry ceiling (engineer <-> QA reject loop) ----
# Max QA rejects (tickets.retry_count) before the dispatcher stops handing the
# ticket back to the engineer and parks it to `blocked` for a human. Each lap of
# that loop costs a full engineer run plus a full QA run, and the two roles can
# disagree forever. A human moving the ticket out of `blocked` resets the budget.
# Default 3 (= 4 engineer attempts). A non-numeric or < 1 value falls back to 3.
DEVPILOT_QA_MAX_RETRIES=3

# ---- Held-scaffolder abandonment fallback ----
# A plan-mode "Create new repo" files its project_scaffolder ticket HELD (backlog,
# undispatched) so the planning discussion can inform it; committing the plan
# releases it. This is how long the ticket waits for that commit before the
# fallback releases it anyway with base context - the guarantee that an empty
# repo (auto_init:false) never stays empty when a plan is abandoned. Firing early
# only costs a less-informed scaffold; firing late only costs latency, so this
# errs long. Default 90 minutes. A non-numeric or < 1 value falls back to 90 -
# a typo must not be able to switch the guarantee off.
DEVPILOT_SCAFFOLDER_HOLD_TTL_MINUTES=90

# ---- Agent-filed tickets (WI-14: the devpilot_create_ticket MCP tool) ----
# How many NEW backlog tickets ONE agent run may file when it finds work that is
# out of scope for the ticket it is on. This is a hard per-run fan-out ceiling in
# the same family as DEVPILOT_MAX_FAN_OUT: each filed ticket is work a human can later
# promote into a billable run, so an uncapped agent could paper the board. The
# counter is durable (runs.tickets_created_count, claimed atomically), so it
# survives a restart mid-run. Default 3. A non-numeric or < 1 value falls back to
# 3 - a safety ceiling must not be switch-off-able by a typo.
#
# This is the INSTANCE-WIDE rung. The ceiling resolves
# `projects.agent_ticket_max_per_run` (NULL = inherit) » this var » 3, so a
# planning-heavy board can raise it from its project page without raising it for
# every project here. Sized for the ordinary case - an engineer noticing two or
# three stray things. A DECOMPOSITION ticket, whose whole job is to be broken
# into children, legitimately needs more; raise it per project rather than here.
#
# The tool ALSO needs the per-project opt-in `projects.agent_ticket_creation`
# (column default FALSE), so this var alone turns nothing on. Both
# project-creation forms carry a visible, pre-ticked control for it, so a project
# made through the UI arrives armed by the operator's own choice; an existing
# project keeps whatever it has and is never armed underneath its owner. The
# switch lives on the project page under "Agent autonomy".
#
# Agent-filed tickets always land in `backlog` with no requested role: they
# cannot start a run until a human promotes them to `ready`.
DEVPILOT_MAX_TICKETS_PER_RUN=3

# ---- Auto-land (WI-4/WI-5: the ace/<slug> -> integration-branch merge queue) ----
# INSTANCE-WIDE KILL SWITCH for the land worker. Set to 0 to stop every project
# from auto-landing, regardless of its own opt-in. The per-project opt-in is
# `projects.auto_land_enabled` (default FALSE, toggled from the project page), so
# leaving this at 1 does NOT turn auto-land on for anyone by itself.
#
# What auto-land does: when a ticket reaches `done` with a branch, it is queued
# on `integration_queue` and a durable worker rebases it onto the LIVE tip of the
# project's integration branch and squash-merges it in, ONE ticket at a time per
# project, in dependency order. It then stamps `tickets.landed_sha` — the single
# truth that a ticket's work is actually on the integration branch, which the
# readiness gate (WI-5) uses instead of `status = done`.
#
# What it does NOT change: HUMAN review still sits at integration -> production
# (the Promote button). Every per-ticket automated gate (QA verdict, the L1 QA
# hand-off gate, the SME safety gate) still has to pass before a ticket can reach
# `done` and be enqueued at all.
DEVPILOT_AUTO_LAND_ENABLED=1

# Never-triggered-land sweep (lib/engine/land-rescue-reaper.ts). Landing is
# event-driven, so an `integration/land-needed` event that is lost leaves the
# queue row `pending` forever with nothing looking at it — observed in
# production as finished work sitting outside `dev` for hours. A 5-minute cron
# re-emits the event for such a row. Gated by DEVPILOT_AUTO_LAND_ENABLED above.
#
# How long (seconds) a pending row must sit untouched before its FIRST rescue.
# Each subsequent rescue doubles the wait (capped at 3h), so a land that fails
# for a permanent reason is not hammered. Default 300 (5 min), matching the
# cadence of the blind cron floor this replaced.
DEVPILOT_LAND_RESCUE_GRACE_SECONDS=300
# How many times one row may be re-emitted before it is failed for good rather
# than retried forever. With the doubling backoff, ~5 hours of trying. Default 6.
# A row the claim is legitimately skipping (a `builds_on` parent that has not
# landed yet) is never counted and never given up on.
DEVPILOT_LAND_RESCUE_MAX=6
# Rows evaluated per tick. Default 25.
DEVPILOT_LAND_RESCUE_BATCH=25

# ---- Unqueued-land sweep (a landing nothing ever ASKED for) ----
# The rescue above covers a queue row whose event was lost. This one covers the
# shape neither it nor the integration-queue reaper can see AT ALL: a `done`,
# unlanded ticket that holds a branch and has NO integration_queue row, because
# both of those sweeps SELECT FROM the queue. Measured live on one board: three
# such tickets, invisible to the entire recovery layer, permanently. Runs on a
# 5-minute cron and is gated by DEVPILOT_AUTO_LAND_ENABLED above.
#
# How long (seconds) a ticket must sit done-and-unlanded before the sweep will
# look at it. Must stay ABOVE the 5-minute cron period, or the sweep races a
# ticket's own inline enqueue on the `→ done` seam (and the async
# `pending_push.upserted` enqueue behind it). Default 900 (15 min); a test pins
# the relationship.
DEVPILOT_UNQUEUED_LAND_GRACE_SECONDS=900
# Done-and-unlanded tickets examined per tick. Default 50.
DEVPILOT_UNQUEUED_LAND_SCAN=50

# ---- Merger-outcome sweep (the landing a merger can never get) ----
#
# A MERGER ticket ("Resolve merge conflict: …") resolves its conflict in the
# SOURCE ticket's workspace, on the SOURCE ticket's branch. It has no branch of
# its own and can never land - every sweep above correctly stands down on one,
# and nothing recorded the outcome, so it sat `done` with no landing forever and
# every surface reported it as stranded. Measured on one board: 26 of 30
# "stranded" tickets were this. This cron records the terminal `nothing_to_land`
# outcome once the merger's SOURCE has landed. It enqueues nothing and lands
# nothing.
#
# How long (seconds) a finished merger must sit before the sweep looks at it.
# The source having landed is the real gate; this only keeps the sweep off a
# ticket that changed a moment ago. Must stay ABOVE the 5-minute cron period;
# a test pins the relationship. Default 900 (15 min).
DEVPILOT_MERGER_OUTCOME_GRACE_SECONDS=900
# Finished mergers examined per tick. Default 50.
DEVPILOT_MERGER_OUTCOME_SCAN=50

# ---- Ticket reconciler + stuck-ticket sweeper (engine self-healing) ----
# When a run completes 'done' without advancing its ticket, the engine applies
# the role's FSM contract (lib/engine/reconcile-policy.ts). Hard ceiling on such
# interventions per ticket PHASE (the count resets whenever an agent moves the
# ticket under its own power - an `devpilot_move_ticket` verdict). At the cap the
# ticket stays put and a `ticket-reconcile-cap` comment tells the operator why.
# Default 3.
DEVPILOT_TICKET_RECONCILE_MAX_ATTEMPTS=3
# Cron (every 5 min) that repairs tickets already stranded in a working state
# after their latest run completed. Set to 0 to disable.
DEVPILOT_STUCK_TICKET_SWEEP=1
# How long (seconds) a ticket must sit untouched — and its latest run be
# finished — before the sweeper treats it as stuck. Default 600 (10 min).
DEVPILOT_STUCK_TICKET_SWEEP_THRESHOLD_SECONDS=600
# Per-tick cap on tickets the sweeper actually acts on (transition/dispatch;
# also the scan page size). Default 25.
DEVPILOT_STUCK_TICKET_SWEEP_BATCH=25

# ---- Orphaned-ticket reaper (engine self-healing) ----
# The sweeper above only repairs tickets whose LATEST run is 'done'. A ticket
# whose latest run ended 'failed'/'cancelled' - or which has no runs at all -
# sits in an agent-owned state with nothing live and nothing queued, and
# silently swallows every human reply (only an `input_required` ticket
# re-dispatches on a comment). This cron (every 5 min) hands those back to the
# human: in_progress -> input_required, in_review -> blocked, with a system
# comment explaining what happened. Set to 0 to disable.
DEVPILOT_ORPHAN_TICKET_REAPER=1
# How long (seconds) a ticket must show no sign of life - measured from the
# LATER of its own updated_at and its newest run's last event - before it is
# declared orphaned. Default 1800 (30 min). Must stay comfortably above
# DEVPILOT_STALE_RUN_THRESHOLD_MINUTES (15) plus the 5-minute cron period, so a
# wedged run is failed by the stale-run reaper BEFORE this one speaks; the rest
# of the margin covers the dispatch-event -> runs-row write race.
DEVPILOT_ORPHAN_TICKET_GRACE_SECONDS=1800
# Per-tick cap on candidates scanned. Default 25.
DEVPILOT_ORPHAN_TICKET_REAPER_BATCH=25

