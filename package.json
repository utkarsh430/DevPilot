{
  "name": "devpilot",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "turbo run dev",
    "setup:local": "pnpm --filter @devpilot/web setup:local",
    "dev:local": "pnpm --filter @devpilot/web dev:local",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:brand": "node scripts/check-legacy-brand.mjs"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "inngest-cli",
      "node-pty",
      "sharp",
      "unrs-resolver"
    ],
    "patchedDependencies": {
      "@react-pdf/pdfkit@5.1.1": "patches/@react-pdf__pdfkit@5.1.1.patch"
    }
  }
}
