{
  "name": "@devpilot/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "setup:local": "node --import tsx scripts/setup-local.mjs",
    "dev:local": "node --import tsx scripts/dev-local.mjs",
    "dev:inngest": "node --import tsx scripts/dev-inngest.mjs",
    "dev:inngest:raw": "inngest dev -u http://localhost:3000/api/inngest",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "accept:export-fonts": "node scripts/export-fonts-accept.mjs",
    "accept:guide": "node scripts/guide-manual-accept.mjs",
    "accept:vercel": "node scripts/vercel-accept.mjs",
