    "accept:settle-landed-trigger": "node scripts/settle-landed-trigger-accept.mjs",
    "accept:tickets-write-policy": "node scripts/tickets-write-policy-accept.mjs",
    "accept:console-reply-persist": "node --env-file=.env.local --conditions=react-server --import tsx scripts/console-reply-persist-accept.mjs",
    "capture:guide": "node --import tsx --env-file=.env.local scripts/guide-capture.mjs"
